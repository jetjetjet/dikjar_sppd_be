# Template backend_rev/.env untuk PRODUCTION — lihat DEPLOYMENT.md Bagian 6.1.
#
# Copy ke VPS sebagai backend_rev/.env, isi nilai asli, lalu:
#   chmod 600 .env
#
# JANGAN copy backend_rev/.env dev apa adanya — APP_KEY & kredensial dev
# tidak boleh dipakai di production (APP_KEY dev pernah terekspos di repo).
#
# PENTING: file ini di-.dockerignore (tidak ikut ke-COPY ke image) dan dibaca
# lewat env_file: di docker-compose.prod.yml — parser env_file Docker TIDAK
# mendukung inline comment ("KEY=value # komentar" akan membuat " # komentar"
# ikut jadi bagian dari value). Selalu taruh komentar di baris TERPISAH,
# jangan pernah di baris yang sama dengan KEY=value.
#
# APP_KEY kosongkan di sini — di-generate via `php artisan key:generate --force` (Bagian 9.2).

APP_NAME=SPPD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sppd.disdikkerinci.id

LOG_CHANNEL=stack
LOG_LEVEL=error

# DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD SEMUANYA di-override otomatis
# oleh docker-compose.prod.yml (environment: menang atas env_file:) — nilai asli
# datang dari .env ROOT project (satu-satunya sumber, lihat .env.production.example
# di root & DEPLOYMENT.md Bagian 6.1/6.2). Baris di bawah HANYA dipakai kalau
# `php artisan` dijalankan di luar Docker Compose (mis. debug lokal tanpa container) —
# boleh dibiarkan placeholder untuk deploy normal.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sppd_db
DB_USERNAME=sppd_user
DB_PASSWORD=placeholder_diabaikan_di_production

BCRYPT_ROUNDS=12

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

SPPD_VERIFICATION_URL=https://sppd.disdikkerinci.id/verifikasi

# Cloud storage — kosongkan kalau tetap pakai FILESYSTEM_DISK=public (lokal)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
